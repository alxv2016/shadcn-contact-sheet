{
  "$description": "Mode-independent shadcn/Tailwind theme variables (fonts, spacing unit, shadows) aliased to design-system tokens. Used by this app; not part of the Token Bridge adapter contract.",
  "font-sans": {
    "$type": "string",
    "$value": "{cp.font.sans}"
  },
  "font-heading": {
    "$type": "string",
    "$value": "{cp.font.sans}"
  },
  "spacing": {
    "$type": "dimension",
    "$value": "{cp.spacing.2xs}"
  },
  "shadow-xs": {
    "$type": "string",
    "$value": "{cp.shadow.low}"
  },
  "shadow-sm": {
    "$type": "string",
    "$value": "{cp.shadow.raised}"
  },
  "shadow-md": {
    "$type": "string",
    "$value": "{cp.shadow.overlay}"
  },
  "shadow-lg": {
    "$type": "string",
    "$value": "{cp.shadow.floating}"
  },
  "shadow-xl": {
    "$type": "string",
    "$value": "{cp.shadow.modal}"
  },
  "shadow-2xl": {
    "$type": "string",
    "$value": "{cp.shadow.modal}"
  },
  "focus-ring-width": {
    "$type": "dimension",
    "$value": "{cp.border.width-focus}"
  },
  "focus-ring-offset": {
    "$type": "dimension",
    "$value": "{cp.border.2}"
  }
}
